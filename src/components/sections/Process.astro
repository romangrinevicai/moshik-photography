---
import Icon from '~/components/ui/Icon.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import { process } from '~/data/process';
import { home } from '~/data/home';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section class="process section section--deep" data-section="process">
  <div class="container">
    <SectionHead eyebrow={home.process.eyebrow[lang]} title={home.process.title[lang]} align="center" />
    <ol class="process__list" role="list">
      {
        process.map((step, i) => (
          <li class="process__step" data-reveal style={`--reveal-delay:${i * 110}`}>
            <span class="process__marker">
              <span class="process__num nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="process__icon"><Icon name={step.icon} size={22} stroke={1.3} /></span>
            </span>
            <h3 class="process__title">{step.title[lang]}</h3>
            <p class="process__text">{step.text[lang]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
  }
  .process__list::before {
    content: '';
    position: absolute;
    inset-inline: 2rem;
    inset-block-start: 2rem;
    block-size: 1px;
    background: var(--line-strong);
  }
  .process__step { position: relative; display: grid; gap: 0.9rem; align-content: start; }
  .process__marker { display: flex; align-items: center; gap: 0.9rem; }
  .process__icon {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line-strong);
    transition: background 0.4s, color 0.4s;
    order: -1;
  }
  .process__step:hover .process__icon { background: var(--ink); color: var(--paper); }
  .process__num { font-family: var(--font-display); font-size: 1.1rem; color: var(--accent); }
  .process__title { font-size: 1.55rem; margin-block-start: 0.6rem; }
  .process__text { color: var(--fg-muted); font-size: 0.97rem; }
  @media (max-width: 1000px) {
    .process__list { grid-template-columns: 1fr; gap: 0; }
    .process__list::before { inset-inline: auto; inset-inline-start: 2rem; inset-block: 2rem; inline-size: 1px; block-size: auto; }
    .process__step { grid-template-columns: 4rem 1fr; column-gap: 1.5rem; padding-block-end: 2.2rem; }
    .process__marker { grid-row: span 2; flex-direction: column; align-items: center; }
    .process__num { order: 2; }
    .process__title { margin-block-start: 0.8rem; }
  }
</style>
