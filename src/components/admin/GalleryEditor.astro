  pickFiles: { he: 'בחירת תמונות', en: 'Choose photos' },
  pickFolder: { he: 'בחירת תיקייה', en: 'Choose a folder' },
  targetSet: { he: 'לאיזה פרק להעלות?', en: 'Upload into chapter' },
