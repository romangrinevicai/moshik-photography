---
/** Gallery editor screen: header, tabs (photos · details · faces · share · selections). Driven by scripts/admin/editor. */
import Icon from '~/components/ui/Icon.astro';
import TableCard from '~/components/admin/TableCard.astro';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = {
  back: { he: 'כל הגלריות', en: 'All galleries' },
  view: { he: 'צפייה כלקוח', en: 'View as client' },
  viewLabel: { he: 'פתיחת הגלריה כמו שהאורחים רואים אותה, בלשונית חדשה', en: 'Open the gallery as guests see it, in a new tab' },
  share: { he: 'שיתוף', en: 'Share' },
  publish: { he: 'פרסום הגלריה', en: 'Publish' },
  code: { he: 'קוד גישה', en: 'Access code' },
  copyCode: { he: 'העתקת קוד הגישה', en: 'Copy the access code' },
  tabsLabel: { he: 'חלקי הגלריה', en: 'Gallery sections' },
  tabs: {
    photos: { he: 'תמונות', en: 'Photos' },
    details: { he: 'פרטים והגדרות', en: 'Details & settings' },
    faces: { he: 'זיהוי פנים', en: 'Face search' },
