  dExpires: { he: 'סגירה אוטומטית בתאריך', en: 'Close automatically on' },
  dClear: { he: 'ניקוי', en: 'Clear' },
  dExternal: { he: 'קישור לגלריה חיצונית', en: 'External gallery link' },
  dExternalHint: { he: 'רשות: אם הגלריה נמצאת במקום אחר (Pixieset, Google Drive…), האורחים יועברו לשם.', en: 'Optional: if the gallery lives elsewhere (Pixieset, Google Drive…), guests are sent there.' },
  dGuests: { he: 'מה האורחים יכולים לעשות', en: 'What guests can do' },
  tDownload: { he: 'הורדת תמונות', en: 'Download photos' },
  tDownloadHint: { he: 'כפתור הורדה לתמונה בודדת ולכל הגלריה (ZIP).', en: 'Download buttons for single photos and the whole gallery (ZIP).' },
  tOriginals: { he: 'הורדה באיכות מקורית', en: 'Download in original quality' },
