    en: 'The scan runs right here in your browser — no photo is sent to any outside service, and guests’ selfies never leave their phone.',
  },
  fxOffTitle: { he: 'חיפוש לפי סלפי כבוי בגלריה הזאת', en: 'Selfie search is off for this gallery' },
  fxOffText: { he: 'כשמפעילים אותו, האורחים יכולים למצוא את עצמם בין מאות תמונות בשניות.', en: 'Turn it on and guests can find themselves among hundreds of photos in seconds.' },
  fxEnable: { he: 'הפעלת חיפוש לפי סלפי', en: 'Turn on selfie search' },
  fxRun: { he: 'סריקת פנים', en: 'Analyse faces' },
  fxClear: { he: 'מחיקת נתוני הפנים', en: 'Delete face data' },
  fxCancel: { he: 'עצירה', en: 'Stop' },
  fxProgress: { he: 'התקדמות הסריקה', en: 'Analysis progress' },
  fxKeep: { he: 'זה יכול לקחת כמה דקות. אפשר לעבור ללשונית אחרת — רק לא לסגור את זו.', en: 'This can take a few minutes. Feel free to switch tabs — just keep this one open.' },
  fxPeople: { he: 'האנשים שנמצאו', en: 'People found' },
  fxPeopleHint: { he: 'כל מי שמופיע ביותר מתמונה אחת. האורחים לא רואים את הרשימה הזאת.', en: 'Everyone who appears in more than one photo. Guests don’t see this list.' },
  /* share */
  shDraftAction: { he: 'פרסום עכשיו', en: 'Publish now' },
  shLinks: { he: 'הקישור לגלריה', en: 'Gallery link' },
  shLinksHint: { he: 'הקישור פותח את הגלריה ישירות, בלי להקליד קוד.', en: 'The link opens the gallery directly — no code to type.' },
  shCopy: { he: 'העתקה', en: 'Copy' },
  shOpen: { he: 'פתיחה', en: 'Open' },
  shCode: { he: 'קוד גישה', en: 'Access code' },
  shCodeHint: { he: 'למי שמגיע לאתר בלי הקישור.', en: 'For anyone who comes to the site without the link.' },
  shSend: { he: 'שליחה לזוג', en: 'Send to the couple' },
  shPhone: { he: 'הטלפון שלהם', en: 'Their phone' },
  shPhoneHint: { he: 'רשות — בלי מספר, וואטסאפ יבקש לבחור איש קשר.', en: 'Optional — without a number WhatsApp lets you pick a contact.' },
  shMsg: { he: 'ההודעה', en: 'Message' },
  shWa: { he: 'פתיחה בוואטסאפ', en: 'Open WhatsApp' },
  shMail: { he: 'שליחה במייל', en: 'Send by email' },
  shCopyMsg: { he: 'העתקת ההודעה', en: 'Copy message' },
  shReset: { he: 'חזרה לנוסח המקורי', en: 'Reset to the original text' },
  shQr: { he: 'קוד QR', en: 'QR code' },
  shQrHint: { he: 'לסריקה מהטלפון — מוביל ישר לגלריה.', en: 'Scan with a phone — leads straight to the gallery.' },
  shPng: { he: 'הורדת PNG', en: 'Download PNG' },
  shSvg: { he: 'הורדת SVG', en: 'Download SVG' },
  shCard: { he: 'כרטיס לשולחנות', en: 'Table card' },
  shCardHint: { he: 'מדפיסים, מניחים על השולחנות — והאורחים רואים את התמונות עוד באירוע.', en: 'Print it, place it on the tables — and guests see the photos during the event.' },
  shCardLang: { he: 'שפת הכרטיס', en: 'Card language' },
  shCardGallery: { he: 'כמו הגלריה', en: 'Same as gallery' },
  shCardBoth: { he: 'דו־לשוני', en: 'Bilingual' },
  shPrint: { he: 'הדפסת הכרטיס', en: 'Print card' },
  /* selections */
  selTitle: { he: 'בחירות לאלבום', en: 'Album picks' },
  selHint: { he: 'התמונות שהזוג (או האורחים) בחרו ושלחו מהגלריה.', en: 'Photos the couple (or guests) picked and sent from the gallery.' },
