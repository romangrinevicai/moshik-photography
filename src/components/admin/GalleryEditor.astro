  /* sets */
  setsTitle: { he: 'פרקים', en: 'Chapters' },
  setsHint: { he: 'חלוקה כמו "התארגנות", "חופה", "מסיבה". רשות.', en: 'Split into parts like “Getting ready”, “Ceremony”, “Party”. Optional.' },
  setsAdd: { he: 'הוספה', en: 'Add' },
  setsPh: { he: 'פרק חדש, למשל: חופה', en: 'New chapter, e.g. Ceremony' },
  setsLabel: { he: 'שם פרק חדש', en: 'New chapter name' },
  /* queue */
  qTitle: { he: 'מעלה תמונות…', en: 'Uploading photos…' },
  qBar: { he: 'התקדמות ההעלאה', en: 'Upload progress' },
  pause: { he: 'השהיה', en: 'Pause' },
  cancelUpload: { he: 'ביטול', en: 'Cancel' },
  retry: { he: 'ניסיון חוזר', en: 'Retry failed' },
  clear: { he: 'ניקוי הרשימה', en: 'Clear list' },
  keepOpen: { he: 'אפשר להמשיך לעבוד בניהול בזמן ההעלאה — רק לא לסגור את הלשונית.', en: 'You can keep working in the admin while this uploads — just don’t close the tab.' },
  /* photos */
  phTitle: { he: 'התמונות בגלריה', en: 'Photos in this gallery' },
  sortLabel: { he: 'מיון', en: 'Sort' },
  sortOrder: { he: 'לפי סדר ההעלאה', en: 'Upload order' },
  sortTaken: { he: 'לפי שעת הצילום', en: 'Time taken' },
  sortName: { he: 'לפי שם קובץ', en: 'File name' },
  selectAll: { he: 'בחירה', en: 'Select' },
  selectAllLabel: { he: 'בחירת כל התמונות המוצגות', en: 'Select all shown photos' },
  setFilter: { he: 'סינון לפי פרק', en: 'Filter by chapter' },
  setCover: { he: 'תמונת שער', en: 'Set as cover' },
  del: { he: 'מחיקה', en: 'Delete' },
  clearSel: { he: 'ביטול הבחירה', en: 'Clear selection' },
