  gridLabel: { he: 'תמונות הגלריה', en: 'Gallery photos' },
  /* preview */
  pvClose: { he: 'סגירה', en: 'Close' },
  pvPrev: { he: 'הקודמת', en: 'Previous' },
  pvNext: { he: 'הבאה', en: 'Next' },
  pvOriginal: { he: 'הורדת המקור', en: 'Download original' },
  pvDelete: { he: 'מחיקה', en: 'Delete' },
  /* details */
