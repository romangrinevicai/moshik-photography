  dTitle: { he: 'שם הגלריה', en: 'Gallery name' },
  dSubtitle: { he: 'שורת משנה', en: 'Subtitle' },
  dSubtitlePh: { he: 'למשל: החתונה · גן אירועים בשרון', en: 'e.g. The wedding · a garden venue' },
  dDate: { he: 'תאריך האירוע', en: 'Event date' },
