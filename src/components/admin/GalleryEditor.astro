  tLive: { he: 'גלריה חיה (ביום האירוע)', en: 'Live gallery (on the event day)' },
  tLiveHint: { he: 'תמונות חדשות מופיעות אצל האורחים תוך כדי ההעלאה, בלי לרענן.', en: 'New photos appear for guests while you upload, without refreshing.' },
  statuses: {
    draft: { he: 'טיוטה', en: 'Draft' },
    published: { he: 'מפורסמת', en: 'Published' },
    archived: { he: 'בארכיון', en: 'Archived' },
  },
  he: { he: 'עברית', en: 'Hebrew' },
  en: { he: 'אנגלית', en: 'English' },
  optional: { he: 'רשות', en: 'optional' },
  unsaved: { he: 'יש שינויים שלא נשמרו', en: 'You have unsaved changes' },
  discard: { he: 'ביטול', en: 'Discard' },
  save: { he: 'שמירת השינויים', en: 'Save changes' },
  dangerTitle: { he: 'מחיקת הגלריה', en: 'Delete this gallery' },
  dangerText: { he: 'מוחק את כל התמונות, הקבצים המקוריים, נתוני הפנים והבחירות. אי אפשר לשחזר.', en: 'Removes every photo, original, face data and selection. This can’t be undone.' },
  dangerBtn: { he: 'מחיקת הגלריה…', en: 'Delete gallery…' },
  /* faces */
  fxTitle: { he: 'חיפוש לפי סלפי', en: 'Find yourself with a selfie' },
  fxIntro: {
    he: 'סורקים פעם אחת את הפנים בכל התמונות. אחר כך כל אורח מצלם סלפי ורואה מיד רק את התמונות שבהן הוא מופיע.',
