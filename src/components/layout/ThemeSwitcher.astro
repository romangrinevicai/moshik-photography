---
/**
 * TEMPORARY — cycles through the design directions in src/config/themes.ts.
 * The choice is remembered (localStorage) and mirrored in the URL (?theme=…)
 * so a direction can be shared as a link.
 */
import { themes } from '~/config/themes';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const list = themes.map((t) => ({ id: t.id, name: t.name[lang] }));
const label = { he: 'סגנון', en: 'Theme' };
---
<button class="theme-switch" type="button" data-theme-switch data-themes={JSON.stringify(list)} title={label[lang]}>
  <span class="theme-switch__dots" aria-hidden="true">{list.map(() => <i />)}</span>
  <span class="theme-switch__label">{label[lang]}</span>
  <span class="theme-switch__name" data-theme-name aria-live="polite">{list[0]!.name}</span>
</button>

<script>
  const KEY = 'moshik-theme';
  const root = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]').forEach((btn) => {
    const list = JSON.parse(btn.dataset.themes ?? '[]') as { id: string; name: string }[];
    const name = btn.querySelector<HTMLElement>('[data-theme-name]')!;
    const dots = [...btn.querySelectorAll<HTMLElement>('.theme-switch__dots i')];
    const index = () => Math.max(0, list.findIndex((t) => t.id === (root.dataset.theme ?? 'classic')));
    const render = () => {
      const i = index();
      name.textContent = list[i]!.name;
      dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
    };
    btn.addEventListener('click', () => {
      const next = list[(index() + 1) % list.length]!.id;
      if (next === 'classic') delete root.dataset.theme;
      else root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* private mode */
      }
      const url = new URL(location.href);
      if (next === 'classic') url.searchParams.delete('theme');
      else url.searchParams.set('theme', next);
      history.replaceState(history.state, '', url);
      render();
      window.dispatchEvent(new CustomEvent('theme:change', { detail: next }));
    });
    render();
  });
</script>

<style>
  .theme-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    block-size: 2.4rem;
    padding-inline: 0.85rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.92;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .theme-switch:hover { opacity: 1; background-color: rgb(127 127 127 / 0.12); }
  .theme-switch__dots { display: inline-flex; gap: 3px; }
  .theme-switch__dots i { inline-size: 5px; block-size: 5px; border-radius: 50%; background: currentColor; opacity: 0.3; }
  .theme-switch__dots i.is-on { opacity: 1; }
  .theme-switch__label { opacity: 0.7; }
  .theme-switch__name { font-weight: 600; }
  @media (max-width: 1100px) {
    .theme-switch__label { display: none; }
  }
  @media (max-width: 760px) {
    .theme-switch { block-size: 2rem; gap: 0.4rem; padding-inline: 0.55rem; font-size: 0.7rem; }
    .theme-switch__dots { display: none; }
    :global(.site-header__actions:has(.theme-switch)) { gap: 0.65rem; }
  }
  @media (max-width: 380px) {
    .theme-switch { padding-inline: 0.45rem; }
    :global(.site-header__actions:has(.theme-switch)) { gap: 0.4rem; }
  }
</style>
