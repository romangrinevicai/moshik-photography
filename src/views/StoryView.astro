---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/ui/PageHero.astro';
import Img from '~/components/ui/Img.astro';
import Icon from '~/components/ui/Icon.astro';
import LightboxLink from '~/components/ui/LightboxLink.astro';
import JustifiedGrid from '~/components/ui/JustifiedGrid.astro';
import DateCta from '~/components/sections/DateCta.astro';
import { stories, type Story } from '~/data/stories';
import { serviceBySlug } from '~/data/services';
import { photosIn, altFor, type Photo } from '~/data/photos';
import { breadcrumbSchema, articleSchema } from '~/data/schema';
import { formatDate, localizePath, useTranslations, type Lang } from '~/i18n';
import { getImage } from 'astro:assets';

interface Props {
  lang: Lang;
  story: Story;
}
const { lang, story } = Astro.props;
const t = useTranslations(lang);
const path = `/stories/${story.slug}/`;
const photos = photosIn(`stories/${story.slug}`);
const [cover, ...rest] = photos;
const service = serviceBySlug(story.service);
const idx = stories.findIndex((s) => s.slug === story.slug);
const next = stories[(idx + 1) % stories.length]!;
const nextCover = photosIn(`stories/${next.slug}`)[0];

// Interleave text and photos: paragraph, pair, paragraph, wide, paragraph, pair…
type Block = { kind: 'p'; text: string } | { kind: 'quote'; text: string } | { kind: 'pair'; photos: Photo[] } | { kind: 'wide'; photo: Photo };
const queue = [...rest];
const blocks: Block[] = [];
story.body[lang].forEach((para, i) => {
  if (para.startsWith('> ')) blocks.push({ kind: 'quote', text: para.slice(2) });
  else blocks.push({ kind: 'p', text: para });
  if (i % 2 === 0 && queue.length >= 2) blocks.push({ kind: 'pair', photos: queue.splice(0, 2) });
  else if (queue.length >= 1) blocks.push({ kind: 'wide', photo: queue.shift()! });
});
const leftovers = queue.map((p) => ({ photo: p, label: story.title[lang] }));
const ogImage = cover ? (await getImage({ src: cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const copy = {
  credits: { he: 'קרדיטים', en: 'Credits' },
  next: { he: 'הסיפור הבא', en: 'Next story' },
  more: { he: 'עוד מהיום הזה', en: 'More from the day' },
};
---
<BaseLayout
  lang={lang}
  path={path}
  title={`${story.title[lang]} — ${story.subtitle[lang]}`}
  description={story.excerpt[lang]}
  image={cover?.src}
  type="article"
  header="overlay"
  jsonLd={[
    breadcrumbSchema(lang, [{ name: t('nav.stories'), path: '/stories/' }, { name: story.title[lang], path }]),
    articleSchema(lang, { title: story.title[lang], description: story.excerpt[lang], path, image: ogImage ? new URL(ogImage, Astro.site).href : undefined, date: story.date }),
  ]}
>
  <PageHero
    lang={lang}
    eyebrow={`${service?.title[lang] ?? ''} · ${story.location[lang]} · ${formatDate(`${story.date}-01`, lang, { month: 'long', year: 'numeric' })}`}
    title={story.title[lang]}
    intro={story.subtitle[lang]}
    photo={cover}
    photoAlt={cover ? altFor(cover, lang, story.title[lang]) : ''}
    crumbs={[{ name: t('nav.stories'), path: '/stories/' }, { name: story.title[lang], path }]}
  />

  <article class="story section" data-lightbox>
    {
      blocks.map((b, i) => {
        if (b.kind === 'p')
          return (
            <div class="container container--narrow">
              <p class:list={['story__p', { 'story__p--lead': i === 0 }]} data-reveal>{b.text}</p>
            </div>
          );
        if (b.kind === 'quote')
          return (
            <div class="container container--narrow">
              <blockquote class="story__quote" data-reveal>{b.text}</blockquote>
            </div>
          );
        if (b.kind === 'pair')
          return (
            <div class="container story__pair">
              {b.photos.map((p, k) => (
                <LightboxLink photo={p} caption={story.title[lang]} cursorLabel={t('lb.view')}>
                  <span class:list={['media', k === 0 ? 'ratio-4x5' : 'ratio-4x5']} data-reveal="image" style={`--reveal-delay:${k * 150}`}>
                    <Img photo={p} alt={altFor(p, lang, story.title[lang])} preset="half" />
                  </span>
                </LightboxLink>
              ))}
            </div>
          );
        return (
          <div class="container container--wide story__wide">
            <LightboxLink photo={b.photo} caption={story.title[lang]} cursorLabel={t('lb.view')}>
              <span class="media story__wide-media" style={`--ar:${(b.photo.width / b.photo.height).toFixed(4)}`} data-reveal="image">
                <Img photo={b.photo} alt={altFor(b.photo, lang, story.title[lang])} preset="wide" />
              </span>
            </LightboxLink>
          </div>
        );
      })
    }
  </article>

  {
    leftovers.length > 0 && (
      <section class="section section--flush-top">
        <div class="container container--wide">
          <h2 class="story__more" data-reveal>{copy.more[lang]}</h2>
          <JustifiedGrid lang={lang} items={leftovers} />
        </div>
      </section>
    )
  }

  {
    story.credits && (
      <section class="section--tight">
        <div class="container container--narrow">
          <h2 class="story__credits-title">{copy.credits[lang]}</h2>
          <dl class="story__credits">
            {story.credits.map((c) => (
              <div>
                <dt>{c.role[lang]}</dt>
                <dd>{c.name}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <a class="story-next on-noir" href={localizePath(`/stories/${next.slug}/`, lang)} data-cursor={copy.next[lang]}>
    {nextCover && (
      <span class="story-next__bg" aria-hidden="true">
        <Img photo={nextCover} alt="" preset="full" />
      </span>
    )}
    <span class="container story-next__inner">
      <span class="eyebrow">{copy.next[lang]}</span>
      <span class="story-next__title">{next.title[lang]}</span>
      <span class="story-next__sub">{next.subtitle[lang]} <Icon name="arrow-right" /></span>
    </span>
  </a>

  <DateCta lang={lang} />
</BaseLayout>

<script>
  import '~/scripts/lightbox';
</script>

<style>
  .story { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 5rem); }
  .story__p { font-size: 1.12rem; line-height: 1.85; color: var(--fg-soft); }
  .story__p--lead { font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem); line-height: 1.4; color: var(--fg); font-weight: 350; }
  .story__p--lead::first-letter { font-size: 3.4em; float: inline-start; line-height: 0.85; margin-inline-end: 0.08em; color: var(--accent); }
  .story__quote {
    position: relative;
    padding-block: 1.5rem;
    border-block: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.8rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.3;
    text-align: center;
    color: var(--accent);
  }
  :global(:lang(he)) .story__quote { font-style: normal; }
  .story__pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem); }
  .story__pair :global(a), .story__wide :global(a) { display: block; }
  .story__wide-media { aspect-ratio: var(--ar); inline-size: min(100%, calc(88vh * var(--ar))); margin-inline: auto; }
  .story__more { font-size: var(--fs-h3); margin-block-end: 2rem; }
  .story__credits-title { font-family: var(--font-body); font-size: var(--fs-eyebrow); letter-spacing: var(--eyebrow-tracking); text-transform: var(--label-transform); color: var(--accent); margin-block-end: 1rem; }
  .story__credits { display: grid; gap: 0.6rem; border-block-start: 1px solid var(--rule); padding-block-start: 1rem; }
  .story__credits div { display: flex; justify-content: space-between; gap: 1rem; }
  .story__credits dt { color: var(--fg-muted); }
  .story-next { position: relative; display: block; overflow: hidden; isolation: isolate; padding-block: clamp(6rem, 4rem + 8vw, 11rem); }
  .story-next__bg { position: absolute; inset: 0; z-index: -1; }
  .story-next__bg :global(picture), .story-next__bg :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 1.6s var(--ease-out); }
  .story-next:hover .story-next__bg :global(img) { transform: scale(1.05); }
  .story-next__bg::after { content: ''; position: absolute; inset: 0; background: rgb(10 8 6 / 0.6); }
  .story-next__inner { display: grid; gap: 1rem; justify-items: start; }
  .story-next__title { font-family: var(--font-display); font-size: clamp(3rem, 2rem + 5vw, 7rem); line-height: 1; }
  .story-next__sub { display: inline-flex; align-items: center; gap: 0.7rem; font-size: 1.1rem; color: var(--fg-soft); }
  @media (max-width: 640px) { .story__pair { grid-template-columns: 1fr; } }
</style>
