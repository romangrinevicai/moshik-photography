{
  "name": "moshik-photography",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Moshik — wedding & event photography. Bilingual (Hebrew/English) website with private client galleries and AI face search.",
  "scripts": {
    "predev": "node scripts/copy-face-models.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-face-models.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "checklist": "node scripts/launch-checklist.mjs",
    "photos:import": "node scripts/import-photos.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/noto-serif-hebrew": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/bellefair": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "astro": "^7.3.8",
    "photoswipe": "^5.4.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "lucide-static": "^1.55.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
